# Copy to .env.local. The app runs with every value empty; each one unlocks one thing (see README.md).

# Convex backend. Both default to the live deployment when empty.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Optional pool/history integrations
NEXT_PUBLIC_GRAPH_KEY=
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_ALCHEMY_KEY=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# Swap and bridge fees
NEXT_PUBLIC_BTB_SWAP_FEE_RECEIVER=0xfed2Ff614E0289D41937139730B49Ee158D02299
LIFI_INTEGRATOR=btb-finance
# Leave empty for no BTB bridge fee. Set to 0.01 after registering the fee wallet in LI.FI.
LIFI_FEE=

# Server only, never NEXT_PUBLIC: DexPaprika free API key for the /api/dexpaprika proxy.
DEXPAPRIKA_API_KEY=

# LP range alerts (Web Push). Generate a pair with: npx web-push generate-vapid-keys
# Public key goes here; VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY and VAPID_SUBJECT go on the Convex dashboard.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
