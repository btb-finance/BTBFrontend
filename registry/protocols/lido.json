{
  "slug": "lido",
  "name": "Lido",
  "category": "Liquid Staking",
  "description": "Liquid staking for Ethereum: stake ETH for rebasing stETH, wrap it into non-rebasing wstETH, and unstake through the withdrawal queue (unstETH NFTs). wstETH is bridged to many L2s and chains.",
  "website": "https://lido.fi",
  "docs": "https://docs.lido.fi",
  "defillama": "https://defillama.com/protocol/lido",
  "chains": [
    "ethereum",
    "arbitrum",
    "optimism",
    "base",
    "linea",
    "unichain",
    "bsc",
    "zksync",
    "scroll",
    "mantle",
    "mode",
    "zircuit",
    "soneium",
    "lisk",
    "swellchain",
    "polygon"
  ],
  "vm": "evm",
  "agentAccess": "both",
  "contracts": [
    {
      "chain": "ethereum",
      "chainId": 1,
      "address": "0xae7ab96520DE3A18E5e111B5EaAb095312D7fE84",
      "name": "Lido / stETH",
      "role": "staking",
      "proxy": true,
      "source": "https://docs.lido.fi/deployed-contracts/",
      "keyFunctions": [
        {
          "signature": "submit(address)",
          "kind": "write",
          "payable": true,
          "description": "Stake ETH and mint stETH to msg.sender. Argument: referral address (zero address if none). Reverts if staking is paused or amount exceeds getCurrentStakeLimit(). Sending plain ETH to the contract does the same."
        },
        {
          "signature": "balanceOf(address)",
          "kind": "read",
          "payable": false,
          "description": "stETH balance; changes on each daily rebase (shares * totalPooledEther / totalShares)."
        },
        {
          "signature": "sharesOf(address)",
          "kind": "read",
          "payable": false,
          "description": "Underlying share balance; constant across rebases."
        },
        {
          "signature": "getSharesByPooledEth(uint256)",
          "kind": "read",
          "payable": false,
          "description": "Convert a stETH amount to shares."
        },
        {
          "signature": "getPooledEthByShares(uint256)",
          "kind": "read",
          "payable": false,
          "description": "Convert shares to a stETH amount."
        },
        {
          "signature": "transferShares(address,uint256)",
          "kind": "write",
          "payable": false,
          "description": "Transfer an exact number of shares (avoids the 1-2 wei rounding of transfer)."
        },
        {
          "signature": "transferSharesFrom(address,address,uint256)",
          "kind": "write",
          "payable": false,
          "description": "Transfer shares using an allowance."
        },
        {
          "signature": "transfer(address,uint256)",
          "kind": "write",
          "payable": false,
          "description": "Transfer stETH (may deliver 1-2 wei less than requested)."
        },
        {
          "signature": "approve(address,uint256)",
          "kind": "write",
          "payable": false,
          "description": "Approve a spender (e.g. wstETH for wrap, WithdrawalQueueERC721 for requestWithdrawals)."
        },
        {
          "signature": "permit(address,address,uint256,uint256,uint8,bytes32,bytes32)",
          "kind": "write",
          "payable": false,
          "description": "EIP-2612 signed approval."
        },
        {
          "signature": "getTotalPooledEther()",
          "kind": "read",
          "payable": false,
          "description": "Total ETH controlled by the protocol."
        },
        {
          "signature": "getTotalShares()",
          "kind": "read",
          "payable": false,
          "description": "Total shares in existence."
        },
        {
          "signature": "getCurrentStakeLimit()",
          "kind": "read",
          "payable": false,
          "description": "ETH that can be staked right now; check >= amount before submit."
        },
        {
          "signature": "isStakingPaused()",
          "kind": "read",
          "payable": false,
          "description": "True if staking is paused (submit reverts)."
        }
      ]
    },
    {
      "chain": "ethereum",
      "chainId": 1,
      "address": "0x7f39C581F595B53c5cb19bD0b3f8dA6c935E2Ca0",
      "name": "wstETH",
      "role": "token",
      "proxy": false,
      "source": "https://docs.lido.fi/deployed-contracts/",
      "keyFunctions": [
        {
          "signature": "wrap(uint256)",
          "kind": "write",
          "payable": false,
          "description": "Wrap stETH into wstETH (approve stETH to wstETH first). Returns wstETH minted."
        },
        {
          "signature": "unwrap(uint256)",
          "kind": "write",
          "payable": false,
          "description": "Burn wstETH and receive stETH. Returns stETH received."
        },
        {
          "signature": "getWstETHByStETH(uint256)",
          "kind": "read",
          "payable": false,
          "description": "wstETH amount for a given stETH amount."
        },
        {
          "signature": "getStETHByWstETH(uint256)",
          "kind": "read",
          "payable": false,
          "description": "stETH amount for a given wstETH amount."
        },
        {
          "signature": "stEthPerToken()",
          "kind": "read",
          "payable": false,
          "description": "stETH per 1 wstETH (rate rises roughly daily)."
        },
        {
          "signature": "tokensPerStEth()",
          "kind": "read",
          "payable": false,
          "description": "wstETH per 1 stETH."
        },
        {
          "signature": "balanceOf(address)",
          "kind": "read",
          "payable": false,
          "description": "wstETH balance (non-rebasing)."
        },
        {
          "signature": "approve(address,uint256)",
          "kind": "write",
          "payable": false,
          "description": "Approve a spender (e.g. WithdrawalQueueERC721 for requestWithdrawalsWstETH, or an L1 bridge)."
        },
        {
          "signature": "receive()",
          "kind": "write",
          "payable": true,
          "description": "Sending plain ETH to wstETH stakes it via Lido and returns wstETH to the sender (staking limit applies)."
        }
      ]
    },
    {
      "chain": "ethereum",
      "chainId": 1,
      "address": "0x889edC2eDab5f40e902b864aD4d7AdE8E412F9B1",
      "name": "WithdrawalQueueERC721 (unstETH)",
      "role": "staking",
      "proxy": true,
      "source": "https://docs.lido.fi/deployed-contracts/",
      "keyFunctions": [
        {
          "signature": "requestWithdrawals(uint256[],address)",
          "kind": "write",
          "payable": false,
          "description": "Lock stETH (approve first) and mint one unstETH NFT per amount. Each amount 100 wei to 1000 stETH; owner = zero address means msg.sender. Returns request IDs."
        },
        {
          "signature": "requestWithdrawalsWstETH(uint256[],address)",
          "kind": "write",
          "payable": false,
          "description": "Same, for wstETH (approve wstETH first)."
        },
        {
          "signature": "requestWithdrawalsWithPermit(uint256[],address,(uint256,uint256,uint8,bytes32,bytes32))",
          "kind": "write",
          "payable": false,
          "description": "stETH withdrawal request with EIP-2612 permit (value, deadline, v, r, s). Can be griefed by front-running; fall back to requestWithdrawals."
        },
        {
          "signature": "requestWithdrawalsWstETHWithPermit(uint256[],address,(uint256,uint256,uint8,bytes32,bytes32))",
          "kind": "write",
          "payable": false,
          "description": "wstETH withdrawal request with permit."
        },
        {
          "signature": "getWithdrawalRequests(address)",
          "kind": "read",
          "payable": false,
          "description": "Request IDs (unstETH NFT IDs) owned by an address."
        },
        {
          "signature": "getWithdrawalStatus(uint256[])",
          "kind": "read",
          "payable": false,
          "description": "Per request: amountOfStETH, amountOfShares, owner, timestamp, isFinalized, isClaimed."
        },
        {
          "signature": "getLastCheckpointIndex()",
          "kind": "read",
          "payable": false,
          "description": "Latest checkpoint index, used as the upper bound for findCheckpointHints."
        },
        {
          "signature": "findCheckpointHints(uint256[],uint256,uint256)",
          "kind": "read",
          "payable": false,
          "description": "Hints for claiming: (sorted requestIds, 1, getLastCheckpointIndex())."
        },
        {
          "signature": "getClaimableEther(uint256[],uint256[])",
          "kind": "read",
          "payable": false,
          "description": "Claimable ETH per request (0 unless finalized and unclaimed)."
        },
        {
          "signature": "claimWithdrawals(uint256[],uint256[])",
          "kind": "write",
          "payable": false,
          "description": "Claim ETH for several finalized requests using hints; burns the NFTs."
        },
        {
          "signature": "claimWithdrawalsTo(uint256[],uint256[],address)",
          "kind": "write",
          "payable": false,
          "description": "Claim to a different recipient."
        },
        {
          "signature": "claimWithdrawal(uint256)",
          "kind": "write",
          "payable": false,
          "description": "Claim a single finalized request to msg.sender."
        },
        {
          "signature": "isBunkerModeActive()",
          "kind": "read",
          "payable": false,
          "description": "True if bunker mode is active (finalization may be slowed/discounted after significant losses)."
        },
        {
          "signature": "unfinalizedStETH()",
          "kind": "read",
          "payable": false,
          "description": "Total stETH waiting in the queue."
        }
      ]
    },
