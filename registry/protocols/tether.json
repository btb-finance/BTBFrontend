      "source": "https://tether.to/en/supported-protocols/",
      "keyFunctions": [
        {
          "signature": "transfer(address,uint256)",
          "kind": "write",
          "payable": false,
          "description": "Send USDT (6 decimals). Returns NOTHING (no bool) per the verified ABI: use a SafeERC20-style call that tolerates empty return data. Reverts if sender is blacklisted."
        },
        {
          "signature": "approve(address,uint256)",
          "kind": "write",
          "payable": false,
          "description": "Set allowance. Returns nothing (no bool). Reverts if changing a non-zero allowance to another non-zero value: source has require(!((_value != 0) && (allowed[msg.sender][_spender] != 0))). Approve 0 first, then the new amount."
        },
        {
          "signature": "transferFrom(address,address,uint256)",
          "kind": "write",
          "payable": false,
          "description": "Spend an allowance: from, to, amount. Returns nothing (no bool)."
        },
        {
          "signature": "balanceOf(address)",
          "kind": "read",
          "payable": false,
          "description": "USDT balance in base units (6 decimals)."
        },
        {
          "signature": "allowance(address,address)",
          "kind": "read",
          "payable": false,
          "description": "Allowance: owner, spender."
        },
        {
          "signature": "decimals()",
          "kind": "read",
          "payable": false,
          "description": "Returns uint256 6 (note: uint256, not uint8)."
        },
        {
          "signature": "isBlackListed(address)",
          "kind": "read",
          "payable": false,
          "description": "True if Tether has blacklisted the address (it cannot transfer; its funds can be destroyed)."
        },
        {
          "signature": "getBlackListStatus(address)",
          "kind": "read",
          "payable": false,
          "description": "Same check as isBlackListed."
        },
        {
          "signature": "deprecated()",
          "kind": "read",
          "payable": false,
          "description": "True if this contract has been deprecated; calls are then forwarded to upgradedAddress()."
        },
        {
          "signature": "upgradedAddress()",
          "kind": "read",
          "payable": false,
          "description": "Address calls are forwarded to when deprecated."
        },
        {
          "signature": "totalSupply()",
          "kind": "read",
          "payable": false,
          "description": "Total USDT supply on Ethereum."
        }
      ]
    },
