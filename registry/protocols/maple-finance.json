{
  "slug": "maple-finance",
  "name": "Maple Finance",
  "category": "Lending",
  "description": "Institutional, overcollateralized lending. Agents can deposit USDC/USDT/USDG into Maple's syrup pools (syrupUSDC, syrupUSDT, syrupUSDG; ERC-4626 yield-bearing shares) through the SyrupRouter, read share prices, and exit through a queued redemption.",
  "website": "https://maple.finance",
  "docs": "https://docs.maple.finance",
  "defillama": "https://defillama.com/protocol/maple-finance",
  "chains": [
    "ethereum",
    "arbitrum",
    "base",
    "solana",
    "plasma",
    "bsc",
    "mantle",
    "monad",
    "ink",
    "xlayer"
  ],
  "vm": "mixed",
  "agentAccess": "onchain",
  "contracts": [
    {
      "chain": "ethereum",
      "chainId": 1,
      "address": "0x80ac24aA929eaF5013f6436cdA2a7ba190f5Cc0b",
      "name": "syrupUSDC Pool (PoolV2, ERC-4626 share token)",
      "role": "vault",
      "proxy": false,
      "source": "https://docs.maple.finance/integrate/ethereum-mainnet/smart-contract-integration",
      "keyFunctions": [
        {
          "signature": "requestRedeem(uint256,address)",
          "kind": "write",
          "payable": false,
          "description": "Request redemption of syrup shares (owner = your address). Shares move into the WithdrawalManagerQueue; with automatic processing (the default) USDC is sent to you when Maple processes the FIFO queue. This is the only exit path: requestWithdraw()/withdraw() are disabled."
        },
        {
          "signature": "redeem(uint256,address,address)",
          "kind": "write",
          "payable": false,
          "description": "Args: shares, receiver, owner. Only for lenders set to MANUAL withdrawal by Maple: claim after the request has been processed. Automatic-mode lenders do not call this."
        },
        {
          "signature": "balanceOf(address)",
          "kind": "read",
          "payable": false,
          "description": "Share balance (6 decimals)."
        },
        {
          "signature": "convertToAssets(uint256)",
          "kind": "read",
          "payable": false,
          "description": "ERC-4626 exchange rate: USDC per shares (use 1000000 for one share). For display/pricing."
        },
        {
          "signature": "convertToExitAssets(uint256)",
          "kind": "read",
          "payable": false,
          "description": "Shares to assets net of unrealized losses; use for actual redemption value or collateral valuation."
        },
        {
          "signature": "convertToShares(uint256)",
          "kind": "read",
          "payable": false,
          "description": "Assets to shares."
        },
        {
          "signature": "previewRedeem(uint256)",
          "kind": "read",
          "payable": false,
          "description": "Simulated assets for a redemption (ignores redemption limits)."
        },
        {
          "signature": "totalAssets()",
          "kind": "read",
          "payable": false,
          "description": "Total underlying assets managed by the pool."
        },
        {
          "signature": "unrealizedLosses()",
          "kind": "read",
          "payable": false,
          "description": "Unrealized losses (impairments) currently recognised."
        },
        {
          "signature": "maxDeposit(address)",
          "kind": "read",
          "payable": false,
          "description": "Max assets the receiver can deposit (0 if not permissioned)."
        },
        {
          "signature": "manager()",
          "kind": "read",
          "payable": false,
          "description": "PoolManager address for this pool."
        },
        {
          "signature": "asset()",
          "kind": "read",
          "payable": false,
          "description": "Underlying ERC-20 asset."
        }
      ]
    },
    {
      "chain": "ethereum",
      "chainId": 1,
      "address": "0x134cCaaA4F1e4552eC8aEcb9E4A2360dDcF8df76",
      "name": "syrupUSDC SyrupRouter",
      "role": "router",
      "proxy": false,
      "source": "https://docs.maple.finance/integrate/ethereum-mainnet/smart-contract-integration",
      "keyFunctions": [
        {
          "signature": "deposit(uint256,bytes32)",
          "kind": "write",
          "payable": false,
          "description": "Deposit USDC (approve the router first) and receive syrup shares. Args: amount (6 decimals), depositData (bytes32 tag, e.g. a referral/integrator id; zero bytes allowed). Caller must already be permissioned in the PoolPermissionManager."
        },
        {
          "signature": "depositWithPermit(uint256,uint256,uint8,bytes32,bytes32,bytes32)",
          "kind": "write",
          "payable": false,
          "description": "Same as deposit but with an ERC-2612 permit of the asset: amount, deadline, v, r, s, depositData."
        },
        {
          "signature": "authorizeAndDeposit(uint256,uint256,uint8,bytes32,bytes32,uint256,bytes32)",
          "kind": "write",
          "payable": false,
          "description": "First-time deposit: submits a Maple-issued authorization signature (bitmap, deadline, v, r, s) that permissions the caller, then deposits amount with depositData. The signature must come from Maple."
        },
        {
          "signature": "authorizeAndDepositWithPermit(uint256,uint256,uint8,bytes32,bytes32,uint256,bytes32,uint256,uint8,bytes32,bytes32)",
          "kind": "write",
          "payable": false,
          "description": "authorizeAndDeposit plus an ERC-2612 permit for the asset."
        },
        {
          "signature": "nonces(address)",
          "kind": "read",
          "payable": false,
          "description": "Authorization nonce for an owner (used when building authorization signatures)."
        },
        {
          "signature": "pool()",
          "kind": "read",
          "payable": false,
          "description": "The syrup pool this router deposits into."
        },
        {
          "signature": "poolManager()",
          "kind": "read",
          "payable": false,
          "description": "PoolManager of the pool."
        },
        {
          "signature": "poolPermissionManager()",
          "kind": "read",
          "payable": false,
          "description": "PoolPermissionManager address."
        },
        {
          "signature": "asset()",
          "kind": "read",
          "payable": false,
          "description": "Underlying asset."
        }
      ]
    },
    {
      "chain": "ethereum",
      "chainId": 1,
      "address": "0x1bc47a0Dd0FdaB96E9eF982fdf1F34DC6207cfE3",
      "name": "syrupUSDC WithdrawalManagerQueue",
      "role": "other",
      "proxy": true,
      "source": "https://docs.maple.finance/integrate/ethereum-mainnet/smart-contract-integration",
      "keyFunctions": [
        {
          "signature": "requests(uint256)",
          "kind": "read",
          "payable": false,
          "description": "(owner, shares) of a withdrawal request id."
        },
        {
          "signature": "requestIds(address)",
          "kind": "read",
          "payable": false,
          "description": "Last valid request id for an owner."
        },
        {
          "signature": "queue()",
          "kind": "read",
          "payable": false,
          "description": "(nextRequestId, lastRequestId) of the FIFO queue."
        },
        {
          "signature": "lockedShares(address)",
          "kind": "read",
          "payable": false,
          "description": "Shares an owner has locked in pending requests."
        },
        {
          "signature": "isManualWithdrawal(address)",
          "kind": "read",
          "payable": false,
          "description": "True if the account uses manual withdrawals (must call Pool.redeem after processing)."
        },
        {
          "signature": "manualSharesAvailable(address)",
          "kind": "read",
          "payable": false,
          "description": "Shares a manual-mode owner can redeem now."
        },
        {
          "signature": "removeSharesById(uint256,uint256)",
          "kind": "write",
          "payable": false,
          "description": "Reduce or cancel your own pending request before it is processed: requestId, sharesToRemove. Returns (sharesReturned, sharesRemaining). Requires the WM:removeSharesById permission (passes for allowlisted lenders)."
        },
        {
          "signature": "processRedemptions(uint256)",
          "kind": "write",
          "payable": false,
          "description": "Process queued requests up to maxSharesToProcess. Restricted to Pool Delegate / Operational Admin / registered redeemers; lenders cannot call it."
        }
      ]
    },
