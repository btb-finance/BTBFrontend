        {
          "signature": "wrap(address,uint256)",
          "kind": "write",
          "payable": false,
          "description": "Transfer $M from the caller and mint wM to the recipient. Args: recipient, amount in $M base units."
        },
        {
          "signature": "unwrap(address,uint256)",
